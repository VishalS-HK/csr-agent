# --- Database (Supabase cloud) ---
# Use a SESSION-mode connection on port 5432: the direct connection (IPv6 only)
# or the session pooler (IPv4). Never the transaction pooler on port 6543 --
# it breaks SELECT ... FOR UPDATE and the LangGraph checkpointer.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Supabase Auth ---
# Tokens are verified with the project's public signing keys (JWKS), so the
# app needs no secret -- just the project URL.
SUPABASE_URL=https://<project-ref>.supabase.co
# service_role (or "secret") key from Project Settings -> API Keys. Only
# scripts/link_auth_users.py uses it. Never commit it, never ship it to a client.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (used from week 2) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
